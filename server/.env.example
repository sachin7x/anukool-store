NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://makegood:change-me@localhost:5432/makegood
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Exact origin(s), comma separated. No trailing slash.
FRONTEND_ORIGIN=http://localhost:5173
# Razorpay TEST keys initially. Never expose these in VITE_* variables.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Used by frontend checkout to open Razorpay Checkout.js
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me
